# Backend runtime
NODE_ENV="development"
PORT="3000"

# Database
# For local Docker Compose, use:
# DATABASE_URL="postgresql://gachahub:gachahub@localhost:5433/gachahub?schema=public"
#
# For a hosted database, replace this with your provider connection string.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# Better Auth
# Generate a strong secret for local development and never commit real secrets.
BETTER_AUTH_SECRET="replace-with-a-local-development-secret"
BETTER_AUTH_URL="http://localhost:3000"

# Frontend
FRONTEND_URL="http://localhost:5173"

# Object storage placeholders
# These are not required by the current backend startup path yet, but reserve
# local names for Minio/S3-compatible storage integration.
MINIO_ENDPOINT="localhost"
MINIO_PORT="9000"
MINIO_USE_SSL="false"
MINIO_ACCESS_KEY="replace-with-storage-access-key"
MINIO_SECRET_KEY="replace-with-storage-secret-key"
MINIO_BUCKET="gachahub-local"

# REDIS
REDIS_URL="redis://localhost:6379"
REDIS_KEY_PREFIX=gachahub:dev:

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

CLOUDINARY_IMAGE_UPLOAD_PRESET=gachahub_image_signed
CLOUDINARY_VIDEO_UPLOAD_PRESET=gachahub_video_signed
CLOUDINARY_CHAT_BLOB_UPLOAD_PRESET=gachahub_chat_blob_signed
# Required preset settings (Cloudinary console -> Upload presets), all set to "Signing mode: signed":
#   image preset: allowed formats jpg,jpeg,png,webp,gif and max file size 10 MB
#   video preset: allowed formats mp4,webm,mov and max file size 50 MB
# The same limits are re-checked server-side when an upload is confirmed (MediaService), so a preset
# that is too loose only lets an oversize file sit unconfirmed until the cleanup job removes it.

# Media policies
MEDIA_UPLOAD_EXPIRES_HOURS=24
MEDIA_SIGNATURE_RATE_LIMIT=30
MEDIA_SIGNATURE_RATE_WINDOW_SECONDS=600

#Kafka
# Explicit local mode permits plaintext; deployment must set NODE_ENV=production and TLS.
NODE_ENV=development
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=gachahub-backend
# Local development only; production requires SSL or SASL_SSL with certificate verification.
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
# Optional TLS: KAFKA_SSL_CA_LOCATION, KAFKA_SSL_CERTIFICATE_LOCATION, KAFKA_SSL_KEY_LOCATION, KAFKA_SSL_KEY_PASSWORD
# SASL_SSL: KAFKA_SASL_MECHANISM=SCRAM-SHA-512, KAFKA_SASL_USERNAME, KAFKA_SASL_PASSWORD
KAFKA_NOTIFICATION_GROUP_ID=gachahub-notifications

# Internal moderation input API (must match worker; 32-512 printable ASCII).
# Generate a random service secret. Empty/short values fail backend startup.
MODERATION_WORKER_TOKEN=replace-with-32-or-more-random-characters
# Match the real-model worker Compose bundle. Existing fixture-only setups use moderation-text-v1.
MODERATION_CLASSIFIER_PROFILE=toxicity-mmbert-small-v1
KAFKA_MODERATION_RESULTS_GROUP_ID=gachahub-moderation-results

# Required MVP temporary sanction presets. Only Admin may select custom durations (1-30 days).
MODERATION_DURATION_DAYS=1,3,7,30
# Optional MODERATION_RISK_POLICY_JSON: all four severity weight/halfLifeDays pairs; see docs/stage2e-moderation.md.
