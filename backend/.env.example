# GachaHub Backend - Environment Variable Template
# Copy this file to backend/.env and replace placeholders with local values.
# NEVER commit backend/.env or real credentials.
#
# Prisma 7: .env is not automatically loaded by prisma.config.ts.
# Ensure prisma.config.ts loads dotenv/config if your project relies on .env.

# -----------------------------------------------------------------------------
# Backend runtime
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# -----------------------------------------------------------------------------
# PostgreSQL / Prisma
# -----------------------------------------------------------------------------
# Example local Docker Compose connection; adjust to your own PostgreSQL setup.
DATABASE_URL="postgresql://gachahub:gachahub@localhost:5433/gachahub?schema=public"

# -----------------------------------------------------------------------------
# Authentication (Better Auth)
# -----------------------------------------------------------------------------
# Replace with a strong random secret for your local environment.
BETTER_AUTH_SECRET="replace-with-a-strong-random-secret"
BETTER_AUTH_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:5173"

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"
REDIS_KEY_PREFIX=gachahub:dev:

# -----------------------------------------------------------------------------
# Cloudinary (signed direct uploads)
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

CLOUDINARY_IMAGE_UPLOAD_PRESET=gachahub_image_signed
CLOUDINARY_VIDEO_UPLOAD_PRESET=gachahub_video_signed
CLOUDINARY_CHAT_BLOB_UPLOAD_PRESET=gachahub_chat_blob_signed

# Configure these presets as signed in the Cloudinary dashboard.
# Image: jpg,jpeg,png,webp,gif; maximum 10 MB.
# Video: mp4,webm,mov; maximum 50 MB.
# The backend also validates uploaded media on confirmation.

# -----------------------------------------------------------------------------
# Media upload policies
# -----------------------------------------------------------------------------
MEDIA_UPLOAD_EXPIRES_HOURS=24
MEDIA_SIGNATURE_RATE_LIMIT=30
MEDIA_SIGNATURE_RATE_WINDOW_SECONDS=600

# -----------------------------------------------------------------------------
# Kafka
# -----------------------------------------------------------------------------
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=gachahub-backend
KAFKA_NOTIFICATION_GROUP_ID=gachahub-notifications
KAFKA_MODERATION_RESULTS_GROUP_ID=gachahub-moderation-results

# PLAINTEXT is for local development/test only.
# Production requires SSL or SASL_SSL with certificate verification.
KAFKA_SECURITY_PROTOCOL=PLAINTEXT

# Optional TLS settings (uncomment/configure when needed):
# KAFKA_SSL_CA_LOCATION=/path/to/ca.pem
# KAFKA_SSL_CERTIFICATE_LOCATION=/path/to/client-cert.pem
# KAFKA_SSL_KEY_LOCATION=/path/to/client-key.pem
# KAFKA_SSL_KEY_PASSWORD=replace-with-key-password

# Optional SASL settings (for SASL_SSL):
# KAFKA_SASL_MECHANISM=SCRAM-SHA-512
# KAFKA_SASL_USERNAME=your_kafka_username
# KAFKA_SASL_PASSWORD=your_kafka_password

# -----------------------------------------------------------------------------
# Python / Hugging Face Moderation AI Pipeline
# -----------------------------------------------------------------------------
# Shared secret between NestJS backend and Python moderation worker.
# Must be 32-512 printable ASCII characters; use a cryptographically random value.
MODERATION_WORKER_TOKEN=replace-with-a-strong-random-token-at-least-32-characters

# Must match the classifier profile configured in the Python worker.
MODERATION_CLASSIFIER_PROFILE=toxicity-mmbert-small-v1

# -----------------------------------------------------------------------------
# Moderation enforcement / MVP sanctions
# -----------------------------------------------------------------------------
# Only these four presets are supported; Admin custom durations: 1-30 whole days.
# No permanent or indefinite sanctions.
MODERATION_DURATION_DAYS=1,3,7,30

# Optional: custom risk policy. Must include all four severities with
# weight and halfLifeDays. See backend/docs/stage2e-moderation.md.

# -----------------------------------------------------------------------------
# Optional local object storage placeholders (MinIO / S3-compatible)
# -----------------------------------------------------------------------------
# These are reserved for local integrations; not required by current startup.
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=replace-with-storage-access-key
MINIO_SECRET_KEY=replace-with-storage-secret-key
MINIO_BUCKET=gachahub-local

# -----------------------------------------------------------------------------
# Optional manual / integration test accounts
# -----------------------------------------------------------------------------
# Uncomment only when running tests that require these accounts.
# TEST_ACTOR_EMAIL=your-test-actor@example.com
# TEST_ACTOR_PASSWORD=replace-with-test-password
# TEST_RECIPIENT_EMAIL=your-test-recipient@example.com
# TEST_RECIPIENT_PASSWORD=replace-with-test-password
