generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id
  name          String
  email         String
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  role   UserRole   @default(USER)
  status UserStatus @default(ACTIVE)

  sessions Session[]
  accounts Account[]

  moderatedGames       GameModerator[]       @relation("GameModeratorUser")
  assignedModerators   GameModerator[]       @relation("GameModeratorAssigner")
  createdChats         ChatConversation[]    @relation("ChatConversationCreator")
  chatParticipants     ChatParticipant[]
  sentChatMessages     ChatMessage[]         @relation("ChatMessageSender")
  chatMessageReceipts  ChatMessageReceipt[]
  directChatPairsAsA   ChatDirectPair[]      @relation("ChatDirectPairUserA")
  directChatPairsAsB   ChatDirectPair[]      @relation("ChatDirectPairUserB")
  chatMessageReactions ChatMessageReaction[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  DELETED
}

enum GameStatus {
  ACTIVE
  ARCHIVED
  HIDDEN
}

model Game {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  iconUrl     String?
  bannerUrl   String?
  developer   String?
  publisher   String?
  status      GameStatus @default(ACTIVE)

  memberCount Int @default(0)
  postCount   Int @default(0)

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categories GameCategory[]
  moderators GameModerator[]

  @@index([status])
  @@index([createdAt])
  @@map("games")
}

model GameCategory {
  id     String @id @default(cuid())
  gameId String

  name        String
  slug        String
  description String?
  icon        String?
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, slug])
  @@index([gameId])
  @@index([isActive])
  @@index([sortOrder])
  @@map("game_categories")
}

model GameModerator {
  id String @id @default(cuid())

  gameId     String
  userId     String
  assignedBy String?

  createdAt DateTime @default(now())

  game     Game  @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user     User  @relation("GameModeratorUser", fields: [userId], references: [id], onDelete: Cascade)
  assigner User? @relation("GameModeratorAssigner", fields: [assignedBy], references: [id], onDelete: SetNull)

  @@unique([gameId, userId])
  @@index([gameId])
  @@index([userId])
  @@index([assignedBy])
  @@map("game_moderators")
}

enum ChatConversationType {
  DIRECT
  GROUP
  GAME_ADMIN
  FORUM_SUPPORT
}

enum ChatConversationStatus {
  ACTIVE
  ARCHIVED
  LOCKED
}

enum ChatParticipantRole {
  OWNER
  ADMIN
  MEMBER
}

enum ChatParticipantState {
  ACTIVE
  PENDING
  DECLINED
  BLOCKED
  ARCHIVED
}

enum ChatMessageContentType {
  TEXT
  IMAGE
  FILE
  AUDIO
  VIDEO
  SYSTEM
}

enum ChatMessageStatus {
  SENT
  DELETED
}

enum ChatMessageReactionType {
  LIKE
  LOVE
  LAUGH
  WOW
  SAD
  ANGRY
}

model ChatConversation {
  id            String                 @id @default(cuid())
  type          ChatConversationType   @default(DIRECT)
  status        ChatConversationStatus @default(ACTIVE)
  title         String?
  photoUrl      String?
  createdBy     String?
  lastMessageId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creator      User?             @relation("ChatConversationCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  participants ChatParticipant[]
  directPair   ChatDirectPair?
  messages     ChatMessage[]

  @@index([type])
  @@index([status])
  @@index([updatedAt])
  @@index([createdBy])
  @@map("chat_conversations")
}

model ChatParticipant {
  id             String               @id @default(cuid())
  conversationId String
  userId         String
  role           ChatParticipantRole  @default(MEMBER)
  state          ChatParticipantState @default(ACTIVE)
  lastReadAt     DateTime?
  archivedAt     DateTime?
  mutedAt        DateTime?
  blockedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId, state])
  @@index([conversationId, state])
  @@map("chat_participants")
}

model ChatDirectPair {
  id             String @id @default(cuid())
  conversationId String @unique
  userIdA        String
  userIdB        String

  createdAt DateTime @default(now())

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userA        User             @relation("ChatDirectPairUserA", fields: [userIdA], references: [id], onDelete: Cascade)
  userB        User             @relation("ChatDirectPairUserB", fields: [userIdB], references: [id], onDelete: Cascade)

  @@unique([userIdA, userIdB])
  @@index([userIdA])
  @@index([userIdB])
  @@map("chat_direct_pairs")
}

model ChatMessage {
  id              String                 @id @default(cuid())
  conversationId  String
  senderId        String
  clientMessageId String?
  ciphertext      String
  encryptionMeta  Json?
  contentType     ChatMessageContentType @default(TEXT)
  status          ChatMessageStatus      @default(SENT)
  replyToId       String?

  createdAt DateTime  @default(now())
  editedAt  DateTime?
  deletedAt DateTime?

  conversation ChatConversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User                  @relation("ChatMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  replyTo      ChatMessage?          @relation("ChatMessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies      ChatMessage[]         @relation("ChatMessageReplies")
  receipts     ChatMessageReceipt[]
  reactions    ChatMessageReaction[]

  @@unique([senderId, clientMessageId])
  @@index([conversationId, createdAt])
  @@index([conversationId, id])
  @@index([senderId])
  @@index([replyToId])
  @@map("chat_messages")
}

model ChatMessageReceipt {
  id          String    @id @default(cuid())
  messageId   String
  userId      String
  deliveredAt DateTime?
  readAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId, deliveredAt])
  @@index([userId, readAt])
  @@map("chat_message_receipts")
}

model ChatMessageReaction {
  id        String                  @id @default(cuid())
  messageId String
  userId    String
  type      ChatMessageReactionType

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([messageId])
  @@index([userId])
  @@map("chat_message_reactions")
}
