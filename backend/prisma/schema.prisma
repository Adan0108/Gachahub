// Append-only record of moderator/admin actions. actorId and gameId are SetNull so the trail
// outlives a deleted account or game; actorName/gameSlug are snapshotted at write time so an entry
// stays readable after that happens. targetId is a plain string (polymorphic, no FK) for the same reason.
model AuditLog {
  id         String          @id @default(cuid())
  gameId     String?
  actorId    String?
  actorName  String?
  gameSlug   String?
  action     AuditAction
