  REPORT_CLAIMED
  REPORT_RESOLVED
  REPORT_DISMISSED
  CASE_CLAIMED
  CASE_ASSIGNED
  CASE_RESOLVED
  CASE_DISMISSED
  MODERATOR_ASSIGNED
  MODERATOR_REMOVED
