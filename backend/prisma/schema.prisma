  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("CommentReplies")

  @@index([postId, createdAt])
  @@index([authorId])
  @@index([parentId, createdAt])
  @@map("comments")
}

enum ReportTargetType {
  POST
  COMMENT
}

enum ReportReason {
  UNMARKED_SPOILERS
  HARASSMENT
  HATE
  VIOLENCE
  COMMERCIAL_SPAM
  SCAM
  IMPERSONATION
  MISINFORMATION
  NSFW
  OTHER
}

enum ModerationCaseStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  DISMISSED
}

enum ModerationRiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Report {
  id         String           @id @default(cuid())
  caseId     String
  reporterId String?
  targetType ReportTargetType
  targetId   String
  reasonCode ReportReason
  details    String?

  /// Immutable moderation evidence; versioned shape in reports/domain/report-target-snapshot.ts.
  targetSnapshot Json?

  createdAt DateTime @default(now())

  reporter User?          @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: SetNull)
  case     ModerationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  // Reporter duplication is checked while holding the case row lock. Closed
  // cases allow re-reporting; no unconditional reporter/target unique constraint.
  @@index([reporterId, createdAt])
  @@index([caseId, createdAt])
  @@index([targetType, targetId])
  @@map("reports")
}

model ModerationCase {
  id         String           @id @default(cuid())
  targetType ReportTargetType
  targetId   String
  /// Denormalized from the target for game moderation queries; null for platform cases or a deleted game.
  gameId     String?

  status              ModerationCaseStatus @default(OPEN)
  reportCount         Int                  @default(0)
  uniqueReporterCount Int                  @default(0)
  lastReportedAt      DateTime             @default(now())
  currentRiskScore    Float?
  currentRiskLevel    ModerationRiskLevel?

  assignedModeratorId String?
  resolutionNote      String?
  resolvedById        String?
  resolvedAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reports           Report[]
  game              Game?    @relation(fields: [gameId], references: [id], onDelete: SetNull)
  assignedModerator User?    @relation("ModerationCasesAssigned", fields: [assignedModeratorId], references: [id], onDelete: SetNull)
  resolvedBy        User?    @relation("ModerationCasesResolved", fields: [resolvedById], references: [id], onDelete: SetNull)

  // Partial unique index moderation_cases_open_target_key in migration
  // 20261015060000: (targetType, targetId) WHERE status IN ('OPEN', 'IN_REVIEW').
  // Prisma cannot express this constraint; preserve the hand-written index.
  // Do not add an unconditional @@unique: closed cases must allow a new case for the target.
  @@index([gameId, status, createdAt])
  @@index([lastReportedAt, id])
  @@index([gameId, status, lastReportedAt, id])
  @@index([gameId, createdAt])
  @@index([status, currentRiskLevel, createdAt])
  @@index([targetType, targetId])
  @@index([assignedModeratorId])
  @@map("moderation_cases")
}

