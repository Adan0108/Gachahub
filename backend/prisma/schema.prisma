enum MediaPurpose {
  POST
  COMMENT
  CHAT
  AVATAR
  BANNER
  GAME_ICON
  GAME_BANNER
  GROUP_PHOTO
  COMMUNITY
}

enum MediaResourceType {
  IMAGE
  VIDEO
}

/// Encrypted chat blob flavour; null on a MediaUpload means plain media.
enum MediaOpaqueKind {
  BLOB
  THUMB
}

enum MediaUploadStatus {
  INITIATED
  UPLOADED
  CLEANING
  ATTACHED
  DELETED
  FAILED
  /// An ATTACHED upload whose Cloudinary release failed; retried on a backoff by ChatMediaReleaseRetryService.
  RELEASE_FAILED
}

model MediaUpload {
  id     String @id @default(cuid())
  userId String

  purpose      MediaPurpose
  resourceType MediaResourceType
  status       MediaUploadStatus @default(INITIATED)

  /// Set for encrypted chat blobs (stored raw); resourceType is then unused.
  opaqueKind MediaOpaqueKind?

  /// Cloudinary immutable asset identifier.
  assetId String? @unique

  /// Cloudinary public ID generated by the backend, never chosen by the frontend.
  publicId String @unique

  secureUrl String?
  version   Int?
  format    String?

  bytes    Int?
  width    Int?
  height   Int?
  duration Float?

  /// Signature from Cloudinary's upload response; optional.
  responseSignature String?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  uploadedAt DateTime?
  attachedAt DateTime?
  deletedAt  DateTime?

  user                  User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postMedia             PostMedia?
  chatMessageMedia      ChatMessageMedia?
  gameIconFor           Game?                    @relation("GameIconUpload")
  gameBannerFor         Game?                    @relation("GameBannerUpload")
  avatarFor             User?                    @relation("UserAvatarUpload")
  chatGroupPhotoFor     ChatConversation?        @relation("ChatGroupPhotoUpload")
  communityMessageMedia GameChannelMessageMedia?

  @@index([userId, status, createdAt])
  @@index([status, createdAt])
  @@index([purpose, status])
  @@map("media_uploads")
}

model ChatUserBlock {
