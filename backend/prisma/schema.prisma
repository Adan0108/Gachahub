generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id
  name          String
  email         String
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  role                  UserRole              @default(USER)
  status                UserStatus            @default(ACTIVE)
  messageRequestSetting MessageRequestSetting @default(EVERYONE)

  sessions     Session[]
  accounts     Account[]
  posts        Post[]
  mediaUploads MediaUpload[]
  postLikes    PostLike[]
  comments     Comment[]
  interests    UserInterest[]

  followers            UserFollow[]          @relation("UserFollowers")
  following            UserFollow[]          @relation("UserFollowing")
  moderatedGames       GameModerator[]       @relation("GameModeratorUser")
  assignedModerators   GameModerator[]       @relation("GameModeratorAssigner")
  createdChats         ChatConversation[]    @relation("ChatConversationCreator")
  gameMemberships      GameMember[]
  chatParticipants     ChatParticipant[]
  sentChatMessages     ChatMessage[]         @relation("ChatMessageSender")
  chatMessageReceipts  ChatMessageReceipt[]
  directChatPairsAsA   ChatDirectPair[]      @relation("ChatDirectPairUserA")
  directChatPairsAsB   ChatDirectPair[]      @relation("ChatDirectPairUserB")
  chatMessageReactions ChatMessageReaction[]
  createdChatEmotes    ChatEmote[]           @relation("ChatEmoteCreator")
  blockedUsers         ChatUserBlock[]       @relation("ChatUserBlockBlocker")
  blockedBy            ChatUserBlock[]       @relation("ChatUserBlockBlocked")

  receivedNotifications Notification[] @relation("NotificationRecipient")
  actedNotifications    Notification[] @relation("NotificationActor")

  chatDevices ChatDevice[]

  chatBackupKey   ChatBackupKey?
  chatBackupBlobs ChatBackupBlob[]

  @@unique([email])
  // Trigram index for the picker's ILIKE (needs the pg_trgm extension); see migration 20260925150200.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "user_name_trgm_idx")
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The chat device this login belongs to, set when the browser links them; revoking that device ends this session.
  chatDeviceId String?

  @@unique([token])
  @@index([userId])
  @@index([chatDeviceId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model UserFollow {
  followerId  String
  followingId String

  createdAt DateTime @default(now())

  follower User @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)

  following User @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  // Useful when looking up the followers of one author.
  @@index([followingId, followerId])
  @@map("user_follows")
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  DELETED
}

enum MessageRequestSetting {
  EVERYONE
  FOLLOWERS
  NO_ONE
}

enum GameMemberRole {
  MEMBER
  MODERATOR
  ADMIN
}

enum GameStatus {
  ACTIVE
  ARCHIVED
  HIDDEN
}

model Game {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  iconUrl     String?
  bannerUrl   String?
  developer   String?
  publisher   String?
  status      GameStatus @default(ACTIVE)

  memberCount Int @default(0)
  postCount   Int @default(0)

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categories GameCategory[]
  moderators GameModerator[]
  posts      Post[]
  members    GameMember[]
  chatEmotes ChatEmote[]

  @@index([status])
  @@index([createdAt])
  @@map("games")
}

model GameCategory {
  id     String @id @default(cuid())
  gameId String

  name        String
  slug        String
  description String?
  icon        String?
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts Post[]

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, slug])
  @@index([gameId])
  @@index([isActive])
  @@index([sortOrder])
  @@map("game_categories")
}

model GameModerator {
  id String @id @default(cuid())

  gameId     String
  userId     String
  assignedBy String?

  createdAt DateTime @default(now())

  game     Game  @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user     User  @relation("GameModeratorUser", fields: [userId], references: [id], onDelete: Cascade)
  assigner User? @relation("GameModeratorAssigner", fields: [assignedBy], references: [id], onDelete: SetNull)

  @@unique([gameId, userId])
  @@index([gameId])
  @@index([userId])
  @@index([assignedBy])
  @@map("game_moderators")
}

model GameMember {
  id     String @id @default(cuid())
  gameId String
  userId String

  role GameMemberRole @default(MEMBER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([gameId, userId])
  @@index([userId])
  @@map("game_members")
}

enum ChatConversationType {
  DIRECT
  GROUP
  GAME_ADMIN
  FORUM_SUPPORT
}

enum ChatConversationStatus {
  ACTIVE
  ARCHIVED
  LOCKED
}

enum ChatParticipantRole {
  OWNER
  ADMIN
  MEMBER
}

enum ChatParticipantState {
  ACTIVE
  PENDING
  DECLINED
  BLOCKED
  ARCHIVED
  /// Authorized to join an MLS conversation; becomes ACTIVE when the Commit adding their device is accepted.
  JOINING
  /// Being removed from an MLS conversation: cut off server-side at once, DECLINED when the Remove Commit is accepted; final immediately if no device is in the group.
  LEAVING
}

enum ChatNotificationLevel {
  ALL
  NOTHING
}

enum ChatMessageContentType {
  TEXT
  IMAGE
  EMOTE
  FILE
  AUDIO
  VIDEO
  SYSTEM
}

enum ChatMessageStatus {
  SENT
  DELETED
}

enum ChatEmoteScope {
  GLOBAL
  GAME
}

model ChatConversation {
  id            String                 @id @default(cuid())
  type          ChatConversationType   @default(DIRECT)
  status        ChatConversationStatus @default(ACTIVE)
  title         String?
  photoUrl      String?
  createdBy     String?
  lastMessageId String?

  /// MLS group epoch; advanced only by an atomic compare-and-set so one Commit wins each epoch.
  mlsEpoch Int @default(0)

  /// Which device is currently finishing this conversation's membership changes, and until when; clears on an accepted Commit or expiry.
  mlsWorkLeaseDeviceId String?
  mlsWorkLeaseUntil    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creator         User?             @relation("ChatConversationCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  participants    ChatParticipant[]
  directPair      ChatDirectPair?
  messages        ChatMessage[]
  mlsHandshakes   MlsHandshake[]
  mlsWelcomes     MlsWelcome[]
  mlsMembers      MlsGroupMember[]
  mlsCommitFaults MlsCommitFault[]

  @@index([type])
  @@index([status])
  @@index([updatedAt])
  @@index([createdBy])
  mlsGroupInfo MlsGroupInfo?

  @@map("chat_conversations")
}

/// The newest public GroupInfo snapshot of a conversation's MLS group; kept only while it matches the current epoch.
model MlsGroupInfo {
  conversationId String   @id
  /// The epoch this snapshot describes; only ever moves forward.
  epoch          Int
  payload        Bytes
  updatedAt      DateTime @updatedAt

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("mls_group_infos")
}

model ChatParticipant {
  id                String                @id @default(cuid())
  conversationId    String
  userId            String
  role              ChatParticipantRole   @default(MEMBER)
  state             ChatParticipantState  @default(ACTIVE)
  lastReadAt        DateTime?
  pinnedAt          DateTime?
  archivedAt        DateTime?
  notificationLevel ChatNotificationLevel @default(ALL)
  mutedUntil        DateTime?
  blockedAt         DateTime?
  deletedAt         DateTime?
  /// When the row last entered PENDING; null otherwise. Invite expiry keys off this, not updatedAt.
  pendingSince      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId, state])
  @@index([conversationId, state])
  // Partial index on pendingSince WHERE state = 'PENDING' lives only in migration 20260925140100 (Prisma can't express it).
  @@map("chat_participants")
}

model ChatDirectPair {
  id             String @id @default(cuid())
  conversationId String @unique
  userIdA        String
  userIdB        String

  createdAt DateTime @default(now())

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userA        User             @relation("ChatDirectPairUserA", fields: [userIdA], references: [id], onDelete: Cascade)
  userB        User             @relation("ChatDirectPairUserB", fields: [userIdB], references: [id], onDelete: Cascade)

  @@unique([userIdA, userIdB])
  @@index([userIdA])
  @@index([userIdB])
  @@map("chat_direct_pairs")
}

model ChatMessage {
  id              String                 @id @default(cuid())
  conversationId  String
  senderId        String
  clientMessageId String?
  ciphertext      String
  encryptionMeta  Json?
  contentType     ChatMessageContentType @default(TEXT)
  status          ChatMessageStatus      @default(SENT)
  replyToId       String?

  createdAt DateTime  @default(now())
  editedAt  DateTime?
  deletedAt DateTime?

  conversation ChatConversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User                  @relation("ChatMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  replyTo      ChatMessage?          @relation("ChatMessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies      ChatMessage[]         @relation("ChatMessageReplies")
  receipts     ChatMessageReceipt[]
  reactions    ChatMessageReaction[]
  media        ChatMessageMedia[]

  @@unique([senderId, clientMessageId])
  @@index([conversationId, createdAt])
  @@index([conversationId, id])
  @@index([senderId])
  @@index([replyToId])
  @@map("chat_messages")
}

model ChatMessageMedia {
  id            String @id @default(cuid())
  messageId     String
  mediaUploadId String @unique

  assetId      String
  publicId     String
  url          String
  resourceType MediaResourceType

  sortOrder Int @default(0)

  width    Int?
  height   Int?
  duration Float?
  bytes    Int?
  format   String?

  createdAt DateTime @default(now())

  message     ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  mediaUpload MediaUpload @relation(fields: [mediaUploadId], references: [id], onDelete: Restrict)

  @@index([messageId, sortOrder])
  @@map("chat_message_media")
}

model ChatMessageReceipt {
  id          String    @id @default(cuid())
  messageId   String
  userId      String
  deliveredAt DateTime?
  readAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId, deliveredAt])
  @@index([userId, readAt])
  @@map("chat_message_receipts")
}

model ChatMessageReaction {
  id        String  @id @default(cuid())
  messageId String
  userId    String
  emoteId   String?
  emoji     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Cascade: a reaction must carry exactly one of emoji/emoteId, so a hard-deleted emote takes its reactions.
  emote   ChatEmote?  @relation(fields: [emoteId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([messageId])
  @@index([userId])
  @@index([emoteId])
  @@map("chat_message_reactions")
}

model ChatEmote {
  id     String         @id @default(cuid())
  scope  ChatEmoteScope
  gameId String?

  shortcode    String
  unicode      String?
  imageUrl     String?
  animationUrl String?

  width    Int?
  height   Int?
  fileSize Int?
  mimeType String?

  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  game      Game? @relation(fields: [gameId], references: [id], onDelete: Cascade)
  createdBy User? @relation("ChatEmoteCreator", fields: [createdById], references: [id], onDelete: SetNull)

  reactions ChatMessageReaction[]

  // Only game-scoped emotes; global shortcode uniqueness is a hand-added partial index in migration 20260805093000.
  @@unique([scope, gameId, shortcode])
  @@index([gameId])
  @@index([createdById])
  @@map("chat_emotes")
}

enum PostStatus {
  DRAFT
  PUBLISHED
  HIDDEN
  DELETED
}

enum PostType {
  GENERAL
  GUIDE
  BUILD
  TEAM
  LORE
  THEORY
  QUESTION
  NEWS
  MEME
}

enum PostVisibility {
  PUBLIC
  FOLLOWERS_ONLY
  PRIVATE
}

enum PostMediaType {
  IMAGE
  GIF
  VIDEO
}

model Post {
  id         String  @id @default(cuid())
  authorId   String
  gameId     String
  categoryId String?

  title   String
  content String

  type       PostType       @default(GENERAL)
  status     PostStatus     @default(PUBLISHED)
  visibility PostVisibility @default(PUBLIC)
  isSpoiler  Boolean        @default(false)

  viewCount     Int @default(0)
  commentCount  Int @default(0)
  reactionCount Int @default(0)
  saveCount     Int @default(0)
  shareCount    Int @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  author   User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  game     Game          @relation(fields: [gameId], references: [id], onDelete: Cascade)
  category GameCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  media     PostMedia[]
  tags      PostTag[]
  postLikes PostLike[]
  comments  Comment[]

  @@index([gameId, status, createdAt])
  @@index([categoryId, status, createdAt])
  @@index([authorId, status, createdAt])
  @@index([type, status, createdAt])
  // Supports global feed reads:
  // PUBLISHED + visibility + undeleted + newest first
  @@index([status, visibility, deletedAt, createdAt, id])
  @@map("posts")
}

model PostMedia {
  id            String @id @default(cuid())
  postId        String
  mediaUploadId String @unique

  assetId  String
  publicId String
  url      String

  mediaType PostMediaType
  altText   String?
  sortOrder Int           @default(0)

  width    Int?
  height   Int?
  duration Float?
  bytes    Int?
  format   String?

  createdAt DateTime @default(now())

  post        Post        @relation(fields: [postId], references: [id], onDelete: Cascade)
  mediaUpload MediaUpload @relation(fields: [mediaUploadId], references: [id], onDelete: Restrict)

  @@index([postId, sortOrder])
  @@map("post_media")
}

model Tag {
  id   String @id @default(cuid())
  name String
  slug String @unique

  createdAt DateTime @default(now())

  posts PostTag[]

  @@map("tags")
}

model PostTag {
  postId String
  tagId  String

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
  @@map("post_tags")
}

model PostLike {
  postId    String
  userId    String
  createdAt DateTime @default(now())

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([postId, userId])
  @@index([userId, createdAt])
}

enum InterestEntityType {
  GAME
  CATEGORY
  POST_TYPE
  TAG
  AUTHOR
}

model UserInterest {
  userId     String
  entityType InterestEntityType
  entityId   String

  score       Float @default(0)
  signalCount Int   @default(0)

  lastSignalAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, entityType, entityId])
  // Main For You profile lookup.
  @@index([userId, score])
  @@map("user_interests")
}

enum MediaPurpose {
  POST
  COMMENT
  CHAT
  AVATAR
  BANNER
}

enum MediaResourceType {
  IMAGE
  VIDEO
}

/// Encrypted chat blob flavour; null on a MediaUpload means plain media.
enum MediaOpaqueKind {
  BLOB
  THUMB
}

enum MediaUploadStatus {
  INITIATED
  UPLOADED
  CLEANING
  ATTACHED
  DELETED
  FAILED
  /// An ATTACHED upload whose Cloudinary release failed; retried on a backoff by ChatMediaReleaseRetryService.
  RELEASE_FAILED
}

model MediaUpload {
  id     String @id @default(cuid())
  userId String

  purpose      MediaPurpose
  resourceType MediaResourceType
  status       MediaUploadStatus @default(INITIATED)

  /// Set for encrypted chat blobs (stored raw); resourceType is then unused.
  opaqueKind MediaOpaqueKind?

  /// Cloudinary immutable asset identifier.
  assetId String? @unique

  /// Cloudinary public ID generated by the backend, never chosen by the frontend.
  publicId String @unique

  secureUrl String?
  version   Int?
  format    String?

  bytes    Int?
  width    Int?
  height   Int?
  duration Float?

  /// Signature from Cloudinary's upload response; optional.
  responseSignature String?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  uploadedAt DateTime?
  attachedAt DateTime?
  deletedAt  DateTime?

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  postMedia        PostMedia?
  chatMessageMedia ChatMessageMedia?

  @@index([userId, status, createdAt])
  @@index([status, createdAt])
  @@index([purpose, status])
  @@map("media_uploads")
}

model ChatUserBlock {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("ChatUserBlockBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("ChatUserBlockBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@map("chat_user_blocks")
}

model Comment {
  id       String  @id @default(cuid())
  postId   String
  authorId String
  parentId String?

  content String

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("CommentReplies")

  @@index([postId, createdAt])
  @@index([authorId])
  @@index([parentId, createdAt])
  @@map("comments")
}

enum NotificationType {
  POST_LIKED
  POST_COMMENTED
  COMMENT_REPLIED

  USER_FOLLOWED
  USER_MENTIONED

  MESSAGE_RECEIVED
  MESSAGE_REPLIED

  GROUP_ADDED
  GROUP_INVITE_PENDING
}

enum NotificationEntityType {
  POST
  COMMENT
  MESSAGE
  CONVERSATION
  USER
}

model Notification {
  id String @id @default(cuid())

  recipientId String
  actorId     String?

  type NotificationType

  entityType NotificationEntityType
  entityId   String

  readAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipient User @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  actor User? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([recipientId, createdAt])
  @@index([recipientId, readAt])
  @@index([actorId])
  @@map("notifications")
}

// MLS devices and key packages: an MLS member is a device, not a user.
model ChatDevice {
  /// Client-supplied id, embedded in the MLS credential of every key package; the server must use the same value.
  id                 String @id
  userId             String
  signaturePublicKey Bytes
  /// Pinned MLS ciphersuite name this device's key packages use.
  ciphersuite        String

  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  /// Set by explicit revocation, the 60-day dormancy sweep, or cap eviction; never by an ordinary logout.
  revokedAt  DateTime?

  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  keyPackages      MlsKeyPackage[]
  sentHandshakes   MlsHandshake[]
  receivedWelcomes MlsWelcome[]

  @@index([userId, revokedAt])
  @@map("chat_devices")
}

enum MlsKeyPackageKind {
  /// Claimed exactly once, never reusable.
  SINGLE_USE
  /// Never consumed by a claim; the fallback when no SINGLE_USE packages remain.
  LAST_RESORT
}

model MlsKeyPackage {
  id       String            @id @default(cuid())
  deviceId String
  kind     MlsKeyPackageKind @default(SINGLE_USE)

  /// The encoded MLS KeyPackage wire bytes, verified at upload time.
  payload Bytes

  createdAt       DateTime  @default(now())
  expiresAt       DateTime
  /// Only set for SINGLE_USE packages; LAST_RESORT is read without being claimed.
  claimedAt       DateTime?
  claimedByUserId String?

  device ChatDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, kind, claimedAt])
  /// Serves the hourly deleteExpiredKeyPackages filter on expiresAt alone.
  @@index([expiresAt])
  @@map("mls_key_packages")
}

// Handshake log: a Commit is the only thing that advances mlsEpoch, one per epoch. Never pruned, since members replay every Commit.
model MlsHandshake {
  id             String  @id @default(cuid())
  conversationId String
  /// The epoch this Commit was built FROM; applying it moves the group to epoch+1, and @@unique allows one Commit per epoch.
  epoch          Int
  /// Nullable, SetNull on delete: the Commit is shared group state members still need, so it must outlive the sender's device.
  senderDeviceId String?

  /// Opaque encoded MLS Commit bytes; the server only routes and orders them.
  payload       Bytes
  /// SHA-256 of payload, to recognise retried duplicate submissions.
  payloadSha256 String

  /// Declared and server-attested device changes: addedDevices = [{ deviceId, userId, signaturePublicKey (base64) }], removedDevices = [{ deviceId, userId }]; other members verify against them. False (arrays empty) for Commits accepted before tracking.
  membershipDeclared Boolean @default(false)
  addedDevices       Json    @default("[]")
  removedDevices     Json    @default("[]")

  createdAt DateTime @default(now())

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderDevice ChatDevice?      @relation(fields: [senderDeviceId], references: [id], onDelete: SetNull)

  @@unique([conversationId, epoch])
  @@map("mls_handshakes")
}

/// Per-recipient-device Welcome, delivered once then marked consumed.
model MlsWelcome {
  id                String @id @default(cuid())
  conversationId    String
  recipientDeviceId String

  payload Bytes

  createdAt  DateTime  @default(now())
  consumedAt DateTime?

  conversation    ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  recipientDevice ChatDevice       @relation(fields: [recipientDeviceId], references: [id], onDelete: Cascade)

  @@index([recipientDeviceId, consumedAt])
  /// Conversation deletes cascade here; without this each one scans the table.
  @@index([conversationId])
  @@map("mls_welcomes")
}

/// Which devices are leaves in a conversation's MLS ratchet tree, kept in sync with accepted Commits. deviceId/userId are plain strings so a leaf outlives its device; a row is history once removedEpoch is set. The one-active-row-per-device partial unique index and epochs CHECK live in migration 20260921100000_add_mls_group_membership.
model MlsGroupMember {
  id             String @id @default(cuid())
  conversationId String
  deviceId       String
  userId         String

  addedEpoch   Int
  removedEpoch Int?

  createdAt DateTime @default(now())

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, removedEpoch])
  @@index([conversationId, userId])
  /// The poll's "is this device in the group" probes filter on both columns.
  @@index([deviceId, removedEpoch])
  @@map("mls_group_members")
}

/// A member's client refused a Commit; recorded so an admin can see which sender and Commit froze the group. Device ids are plain strings so the record outlives the devices.
model MlsCommitFault {
  id               String  @id @default(cuid())
  conversationId   String
  /// The epoch the refused Commit was built from - identifies the handshake row.
  epoch            Int
  /// Who sent the refused Commit; null if that handshake row is gone.
  senderDeviceId   String?
  reporterDeviceId String
  reason           String

  createdAt DateTime @default(now())

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, epoch, reporterDeviceId])
  @@index([conversationId, epoch])
  @@map("mls_commit_faults")
}

/// Turns on encrypted history backup for a user. keyCheck is the client's encryption of a fixed string under the
/// backup key; the key itself never reaches the server.
model ChatBackupKey {
  userId    String   @id
  keyCheck  Bytes
  createdAt DateTime @default(now())
  /// Secret derived from the backup key by the client; verifies the proof that authorises replacing the key. Null on rows made before proofs existed.
  replaceSecret      Bytes?
  /// Single-use challenge for a key replacement; cleared when consumed.
  challengeNonce     Bytes?
  challengeExpiresAt DateTime?
  /// When a proof-less delete request takes effect; the backup stays usable until then. Null when none is scheduled.
  deletionScheduledAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("chat_backup_keys")
}

/// One message's decrypted envelope, encrypted client-side under the backup key. conversationId and messageId are
/// plain strings, not relations, so a backup outlives a deleted message or conversation.
model ChatBackupBlob {
  id             String   @id @default(cuid())
  userId         String
  conversationId String
  messageId      String
  ciphertext     Bytes
  /// ciphertext length in bytes, kept so the quota is a cheap SUM.
  size           Int
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, messageId])
  /// Paging on restore walks a user's blobs in (createdAt, id) order.
  @@index([userId, createdAt, id])
  @@map("chat_backup_blobs")
}
