generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id
  name          String
  email         String
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  role                  UserRole              @default(USER)
  status                UserStatus            @default(ACTIVE)
  messageRequestSetting MessageRequestSetting @default(EVERYONE)
  /// Whether others can see when you read their messages, and you theirs; mutual, like Messenger's setting. Delivery always shows, as a yes or no; that still tells the sender roughly when your device was online.
  sendReadReceipts      Boolean               @default(true)
  /// Whether links you send get a preview card. The server fetches the page when you paste a link, so turning it off keeps links from reaching the server at all.
  sendLinkPreviews      Boolean               @default(true)
  // Claimed once during onboarding; case-insensitive (citext) so "Bob" and "bob" collide,
  // original casing kept for display. Null until the user completes onboarding.
  username              String?               @unique @db.Citext
  onboarded             Boolean               @default(false)
  /// MediaUpload backing `image` (the avatar), so a replace can release the old Cloudinary asset.
  avatarMediaUploadId   String?               @unique
  avatarMediaUpload     MediaUpload?          @relation("UserAvatarUpload", fields: [avatarMediaUploadId], references: [id], onDelete: SetNull)
  /// Id of a design in the backend's profile banner catalog; null shows the default banner.
  bannerPresetId        String?

  sessions     Session[]
  accounts     Account[]
  posts        Post[]
  mediaUploads MediaUpload[]
  postLikes    PostLike[]
  comments     Comment[]
  interests    UserInterest[]
  postSaves    PostSave[]

  followers            UserFollow[]           @relation("UserFollowers")
  following            UserFollow[]           @relation("UserFollowing")
  moderatedGames       GameModerator[]        @relation("GameModeratorUser")
  assignedModerators   GameModerator[]        @relation("GameModeratorAssigner")
  createdChats         ChatConversation[]     @relation("ChatConversationCreator")
  gameMemberships      GameMember[]
  chatParticipants     ChatParticipant[]
  sentChatMessages     ChatMessage[]          @relation("ChatMessageSender")
  chatMessageReceipts  ChatMessageReceipt[]
  directChatPairsAsA   ChatDirectPair[]       @relation("ChatDirectPairUserA")
  directChatPairsAsB   ChatDirectPair[]       @relation("ChatDirectPairUserB")
  chatMessageReactions ChatMessageReaction[]
  createdChatEmotes    ChatEmote[]            @relation("ChatEmoteCreator")
  gameChannelMessages  GameChannelMessage[]   @relation("GameChannelMessageAuthor")
  gameChannelDeletions GameChannelMessage[]   @relation("GameChannelMessageDeleter")
  gameChannelReactions GameChannelReaction[]
  gameChannelReads     GameChannelReadState[]
  chatTimeouts         GameChatTimeout[]      @relation("GameChatTimeoutMember")
  chatTimeoutsGiven    GameChatTimeout[]      @relation("GameChatTimeoutIssuer")
  blockedUsers         ChatUserBlock[]        @relation("ChatUserBlockBlocker")
  blockedBy            ChatUserBlock[]        @relation("ChatUserBlockBlocked")

  reportsFiled            Report[]         @relation("ReportsFiled")
  moderationCasesAssigned ModerationCase[] @relation("ModerationCasesAssigned")
  moderationCasesResolved ModerationCase[] @relation("ModerationCasesResolved")
  auditLogsActed          AuditLog[]       @relation("AuditLogActor")

  receivedNotifications Notification[] @relation("NotificationRecipient")
  actedNotifications    Notification[] @relation("NotificationActor")
  mentions              Mention[]

  chatDevices ChatDevice[]

  chatBackupKey   ChatBackupKey?
  chatBackupBlobs ChatBackupBlob[]

  @@unique([email])
  // Trigram index for the picker's ILIKE (needs the pg_trgm extension); see migration 20260925150200.
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "user_name_trgm_idx")
  @@map("user")
}

model Session {
  id           String   @id
  expiresAt    DateTime
  token        String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  ipAddress    String?
  userAgent    String?
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The chat device this login belongs to, set when the browser links them; revoking that device ends this session.
  chatDeviceId String?

  @@unique([token])
  @@index([userId])
  @@index([chatDeviceId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model UserFollow {
  followerId  String
  followingId String

  createdAt DateTime @default(now())

  follower User @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)

  following User @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  // Useful when looking up the followers of one author.
  @@index([followingId, followerId])
  @@map("user_follows")
}

enum UserRole {
  USER
  PLATFORM_MODERATOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  DELETED
}

enum MessageRequestSetting {
  EVERYONE
  FOLLOWERS
  NO_ONE
}

enum GameMemberRole {
  MEMBER
  MODERATOR
  ADMIN
}

enum GameStatus {
  ACTIVE
  ARCHIVED
  HIDDEN
}

model Game {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  iconUrl     String?
  bannerUrl   String?
  developer   String?
  publisher   String?
  status      GameStatus @default(ACTIVE)

  /// FK to the MediaUpload row currently backing iconUrl/bannerUrl, so a replace can release the old Cloudinary asset.
  iconMediaUploadId   String?      @unique
  bannerMediaUploadId String?      @unique
  iconMediaUpload     MediaUpload? @relation("GameIconUpload", fields: [iconMediaUploadId], references: [id], onDelete: SetNull)
  bannerMediaUpload   MediaUpload? @relation("GameBannerUpload", fields: [bannerMediaUploadId], references: [id], onDelete: SetNull)

  memberCount Int @default(0)
  postCount   Int @default(0)

  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categories      GameCategory[]
  moderators      GameModerator[]
  posts           Post[]
  members         GameMember[]
  chatEmotes      ChatEmote[]
  channels        GameChannel[]
  chatTimeouts    GameChatTimeout[]
  moderationCases ModerationCase[]
  auditLogs       AuditLog[]

  @@index([status])
  @@index([createdAt])
  @@map("games")
}

model GameCategory {
  id     String @id @default(cuid())
  gameId String

  name        String
  slug        String
  description String?
  icon        String?
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts Post[]

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([gameId, slug])
  @@index([gameId])
  @@index([isActive])
  @@index([sortOrder])
  @@map("game_categories")
}

model GameModerator {
  id String @id @default(cuid())

  gameId     String
  userId     String
  assignedBy String?

  createdAt DateTime @default(now())

  game     Game  @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user     User  @relation("GameModeratorUser", fields: [userId], references: [id], onDelete: Cascade)
  assigner User? @relation("GameModeratorAssigner", fields: [assignedBy], references: [id], onDelete: SetNull)

  @@unique([gameId, userId])
  @@index([gameId])
  @@index([userId])
  @@index([assignedBy])
  @@map("game_moderators")
}

model GameMember {
  id     String @id @default(cuid())
  gameId String
  userId String

  role GameMemberRole @default(MEMBER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([gameId, userId])
  @@index([userId])
  @@map("game_members")
}

enum ChatConversationType {
  DIRECT
  GROUP
  GAME_ADMIN
  FORUM_SUPPORT
}

enum ChatConversationStatus {
  ACTIVE
  ARCHIVED
  LOCKED
}

enum ChatParticipantRole {
  OWNER
  ADMIN
  MEMBER
}

enum ChatParticipantState {
  ACTIVE
  PENDING
  DECLINED
  BLOCKED
  ARCHIVED
  /// Authorized to join an MLS conversation; becomes ACTIVE when the Commit adding their device is accepted.
  JOINING
  /// Being removed from an MLS conversation: cut off server-side at once, DECLINED when the Remove Commit is accepted; final immediately if no device is in the group.
  LEAVING
}

enum ChatNotificationLevel {
  ALL
  NOTHING
}

enum ChatMessageContentType {
  TEXT
  IMAGE
  EMOTE
  FILE
  AUDIO
  VIDEO
  SYSTEM
  /// A hidden message carrying a new encrypted body for an earlier message (editsMessageId); never shown, counted unread or notified.
  EDIT
}

enum ChatMessageStatus {
  SENT
  DELETED
}

enum ChatEmoteScope {
  GLOBAL
  GAME
}

model ChatConversation {
  id                 String                 @id @default(cuid())
  type               ChatConversationType   @default(DIRECT)
  status             ChatConversationStatus @default(ACTIVE)
  title              String?
  photoUrl           String?
  /// MediaUpload behind `photoUrl`, so replacing or removing the photo can release the old asset.
  photoMediaUploadId String?                @unique
  createdBy          String?
  lastMessageId      String?

  /// MLS group epoch; advanced only by an atomic compare-and-set so one Commit wins each epoch.
  mlsEpoch Int @default(0)

  /// Which device is currently finishing this conversation's membership changes, and until when; clears on an accepted Commit or expiry.
  mlsWorkLeaseDeviceId String?
  mlsWorkLeaseUntil    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creator          User?             @relation("ChatConversationCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  photoMediaUpload MediaUpload?      @relation("ChatGroupPhotoUpload", fields: [photoMediaUploadId], references: [id], onDelete: SetNull)
  participants     ChatParticipant[]
  directPair       ChatDirectPair?
  messages         ChatMessage[]
  mlsHandshakes    MlsHandshake[]
  mlsWelcomes      MlsWelcome[]
  mlsMembers       MlsGroupMember[]
  mlsCommitFaults  MlsCommitFault[]
  mlsGroupInfo     MlsGroupInfo?

  @@index([type])
  @@index([status])
  @@index([updatedAt])
  @@index([createdBy])
  @@map("chat_conversations")
}

/// The newest public GroupInfo snapshot of a conversation's MLS group; kept only while it matches the current epoch.
model MlsGroupInfo {
  conversationId String   @id
  /// The epoch this snapshot describes; only ever moves forward.
  epoch          Int
  payload        Bytes
  updatedAt      DateTime @updatedAt

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("mls_group_infos")
}

model ChatParticipant {
  id                String                @id @default(cuid())
  conversationId    String
  userId            String
  role              ChatParticipantRole   @default(MEMBER)
  state             ChatParticipantState  @default(ACTIVE)
  lastReadAt        DateTime?
  pinnedAt          DateTime?
  archivedAt        DateTime?
  notificationLevel ChatNotificationLevel @default(ALL)
  mutedUntil        DateTime?
  blockedAt         DateTime?
  deletedAt         DateTime?
  /// When the row last entered PENDING; null otherwise. Invite expiry keys off this, not updatedAt.
  pendingSince      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversation ChatConversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  rounds       ChatMembershipRound[]

  @@unique([conversationId, userId])
  @@index([userId, state])
  @@index([conversationId, state])
  // Partial index on pendingSince WHERE state = 'PENDING' lives only in migration 20260925140100 (Prisma can't express it).
  @@map("chat_participants")
}

/// One time someone was invited to or added to a group, so a chat can tell every round apart:
/// "invited", then "joined the group" once they accept. Invited and never joined is a declined or
/// expired invite.
model ChatMembershipRound {
  id             String    @id @default(cuid())
  conversationId String
  userId         String
  /// When they were invited; null if they were added directly.
  invitedAt      DateTime?
  /// When they became a member: accepted the invite, or were added directly.
  joinedAt       DateTime?
  createdAt      DateTime  @default(now())

  participant ChatParticipant @relation(fields: [conversationId, userId], references: [conversationId, userId], onDelete: Cascade)

  @@index([conversationId, userId, createdAt])
  @@map("chat_membership_rounds")
}

model ChatDirectPair {
  id             String @id @default(cuid())
  conversationId String @unique
  userIdA        String
  userIdB        String

  createdAt DateTime @default(now())

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userA        User             @relation("ChatDirectPairUserA", fields: [userIdA], references: [id], onDelete: Cascade)
  userB        User             @relation("ChatDirectPairUserB", fields: [userIdB], references: [id], onDelete: Cascade)

  @@unique([userIdA, userIdB])
  @@index([userIdA])
  @@index([userIdB])
  @@map("chat_direct_pairs")
}

model ChatMessage {
  id              String                 @id @default(cuid())
  conversationId  String
  senderId        String
  clientMessageId String?
  ciphertext      String
  encryptionMeta  Json?
  contentType     ChatMessageContentType @default(TEXT)
  status          ChatMessageStatus      @default(SENT)
  replyToId       String?
  /// Set only on EDIT messages: the message this one is a new version of.
  editsMessageId  String?

  createdAt DateTime  @default(now())
  editedAt  DateTime?
  deletedAt DateTime?

  conversation ChatConversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User                  @relation("ChatMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  replyTo      ChatMessage?          @relation("ChatMessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies      ChatMessage[]         @relation("ChatMessageReplies")
  editsMessage ChatMessage?          @relation("ChatMessageEdits", fields: [editsMessageId], references: [id], onDelete: Cascade)
  edits        ChatMessage[]         @relation("ChatMessageEdits")
  receipts     ChatMessageReceipt[]
  reactions    ChatMessageReaction[]
  media        ChatMessageMedia[]

  @@unique([senderId, clientMessageId])
  @@index([conversationId, createdAt])
  @@index([conversationId, id])
  @@index([senderId])
  @@index([replyToId])
  @@index([editsMessageId])
  @@map("chat_messages")
}

enum GameChannelKind {
  TEXT
  ANNOUNCEMENT
}

/// A chat room inside one game community. Plaintext on purpose (unlike DMs): moderators must be able to read and remove messages.
model GameChannel {
  id     String @id @default(cuid())
  gameId String

  slug  String
  name  String
  topic String?
  kind  GameChannelKind @default(TEXT)

  sortOrder       Int       @default(0)
  /// Minimum seconds between one member's messages; 0 is off, moderators are exempt.
  slowmodeSeconds Int       @default(0)
  /// Only moderators can post while locked.
  isLocked        Boolean   @default(false)
  archivedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  game       Game                   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  messages   GameChannelMessage[]
  readStates GameChannelReadState[]

  @@unique([gameId, slug])
  @@index([gameId, sortOrder])
  @@map("game_channels")
}

model GameChannelMessage {
  id        String  @id @default(cuid())
  channelId String
  /// Null once the author's account is gone; shown as a deleted user.
  authorId  String?

  content         String
  replyToId       String?
  /// Lets a client retry a send without posting twice.
  clientMessageId String?

  editedAt     DateTime?
  /// Soft delete: the text stays for moderation evidence and is never returned.
  deletedAt    DateTime?
  deletedById  String?
  deleteReason String?

  createdAt DateTime @default(now())

  channel   GameChannel               @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author    User?                     @relation("GameChannelMessageAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  deletedBy User?                     @relation("GameChannelMessageDeleter", fields: [deletedById], references: [id], onDelete: SetNull)
  replyTo   GameChannelMessage?       @relation("GameChannelMessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   GameChannelMessage[]      @relation("GameChannelMessageReplies")
  reactions GameChannelReaction[]
  media     GameChannelMessageMedia[]

  @@unique([authorId, clientMessageId])
  @@index([channelId, createdAt, id])
  @@index([authorId])
  @@index([replyToId])
  @@map("game_channel_messages")
}

model GameChannelReaction {
  id        String  @id @default(cuid())
  messageId String
  userId    String
  emoteId   String?
  emoji     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  message GameChannelMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Cascade: a reaction must carry exactly one of emoji/emoteId, so a hard-deleted emote takes its reactions.
  emote   ChatEmote?         @relation(fields: [emoteId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([messageId])
  @@index([userId])
  @@index([emoteId])
  @@map("game_channel_reactions")
}

/// Where one member has read up to in one channel; unread is counted from here.
/// A member barred from the community chat until a time, set by a moderator; one row per member, replaced on a new timeout.
model GameChatTimeout {
  id          String   @id @default(cuid())
  gameId      String
  userId      String
  until       DateTime
  reason      String?
  createdById String?
  createdAt   DateTime @default(now())

  game      Game  @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user      User  @relation("GameChatTimeoutMember", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User? @relation("GameChatTimeoutIssuer", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([gameId, userId])
  @@index([until])
  @@map("game_chat_timeouts")
}

model GameChannelReadState {
  userId    String
  channelId String

  lastReadAt        DateTime
  lastReadMessageId String?

  updatedAt DateTime @updatedAt

  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel GameChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@id([userId, channelId])
  @@index([channelId])
  @@map("game_channel_read_states")
}

/// An image attached to a community chat message.
model GameChannelMessageMedia {
  id            String @id @default(cuid())
  messageId     String
  mediaUploadId String @unique

  publicId String
  url      String

  sortOrder Int @default(0)

  width  Int?
  height Int?
  bytes  Int?
  format String?

  createdAt DateTime @default(now())

  message     GameChannelMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  mediaUpload MediaUpload        @relation(fields: [mediaUploadId], references: [id], onDelete: Restrict)

  @@index([messageId, sortOrder])
  @@map("game_channel_message_media")
}

model ChatMessageMedia {
  id            String @id @default(cuid())
  messageId     String
  mediaUploadId String @unique

  assetId      String
  publicId     String
  url          String
  resourceType MediaResourceType

  sortOrder Int @default(0)

  width    Int?
  height   Int?
  duration Float?
  bytes    Int?
  format   String?

  createdAt DateTime @default(now())

  message     ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  mediaUpload MediaUpload @relation(fields: [mediaUploadId], references: [id], onDelete: Restrict)

  @@index([messageId, sortOrder])
  @@map("chat_message_media")
}

model ChatMessageReceipt {
  id          String    @id @default(cuid())
  messageId   String
  userId      String
  deliveredAt DateTime?
  readAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId, deliveredAt])
  @@index([userId, readAt])
  @@map("chat_message_receipts")
}

// DB CHECK chat_message_reactions_one_kind: exactly one of emoji/emoteId (hand-added, not in Prisma schema).
model ChatMessageReaction {
  id        String  @id @default(cuid())
  messageId String
  userId    String
  emoteId   String?
  emoji     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Cascade: a reaction must carry exactly one of emoji/emoteId, so a hard-deleted emote takes its reactions.
  emote   ChatEmote?  @relation(fields: [emoteId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([messageId])
  @@index([userId])
  @@index([emoteId])
  @@map("chat_message_reactions")
}

model ChatEmote {
  id     String         @id @default(cuid())
  scope  ChatEmoteScope
  gameId String?

  shortcode    String
  unicode      String?
  imageUrl     String?
  animationUrl String?

  width    Int?
  height   Int?
  fileSize Int?
  mimeType String?

  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  game      Game? @relation(fields: [gameId], references: [id], onDelete: Cascade)
  createdBy User? @relation("ChatEmoteCreator", fields: [createdById], references: [id], onDelete: SetNull)

  reactions        ChatMessageReaction[]
  channelReactions GameChannelReaction[]

  // Only game-scoped emotes; global shortcode uniqueness is a hand-added partial index in migration 20260805093000.
  @@unique([scope, gameId, shortcode])
  @@index([gameId])
  @@index([createdById])
  @@map("chat_emotes")
}

enum PostStatus {
  DRAFT
  PUBLISHED
  HIDDEN
  DELETED
}

enum PostType {
  GENERAL
  GUIDE
  BUILD
  TEAM
  LORE
  THEORY
  QUESTION
  NEWS
  MEME
}

enum PostVisibility {
  PUBLIC
  FOLLOWERS_ONLY
  PRIVATE
}

enum PostMediaType {
  IMAGE
  GIF
  VIDEO
}

// Personal posts have no game, type or category. posts_classification_check and
// posts_clear_detached_classification (migration 20261015050000) enforce this
// and clear classification when a Game deletion sets gameId to null.
model Post {
  id         String  @id @default(cuid())
  authorId   String
  gameId     String?
  categoryId String?

  title   String
  content String

  type       PostType?
  status     PostStatus     @default(PUBLISHED)
  visibility PostVisibility @default(PUBLIC)
  isSpoiler  Boolean        @default(false)

  viewCount     Int @default(0)
  commentCount  Int @default(0)
  reactionCount Int @default(0)
  saveCount     Int @default(0)
  shareCount    Int @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  author   User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  game     Game?         @relation(fields: [gameId], references: [id], onDelete: SetNull)
  category GameCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  media     PostMedia[]
  tags      PostTag[]
  postLikes PostLike[]
  comments  Comment[]
  postSaves PostSave[]

  @@index([gameId, status, createdAt])
  @@index([categoryId, status, createdAt])
  @@index([authorId, status, createdAt])
  @@index([type, status, createdAt])
  // Supports global feed reads:
  // PUBLISHED + visibility + undeleted + newest first
  @@index([status, visibility, deletedAt, createdAt, id])
  @@map("posts")
}

model PostMedia {
  id            String @id @default(cuid())
  postId        String
  mediaUploadId String @unique

  assetId  String
  publicId String
  url      String

  mediaType PostMediaType
  altText   String?
  sortOrder Int           @default(0)

  width    Int?
  height   Int?
  duration Float?
  bytes    Int?
  format   String?

  createdAt DateTime @default(now())

