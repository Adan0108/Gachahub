enum NotificationType {
  POST_LIKED
  POST_COMMENTED
  COMMENT_REPLIED

  USER_FOLLOWED
  USER_MENTIONED

  MESSAGE_RECEIVED
  MESSAGE_REPLIED

  GROUP_ADDED
  GROUP_INVITE_PENDING
}

enum NotificationEntityType {
  POST
  COMMENT
  MESSAGE
  COMMUNITY_MESSAGE
  CONVERSATION
  USER
}

model Notification {
  id String @id @default(cuid())

  recipientId String
  actorId     String?

  type NotificationType

  entityType NotificationEntityType
  entityId   String

  /// The chat conversation a chat notification belongs to.
  conversationId String?
  /// How many messages a stacked chat notification stands for (one row per person and conversation while unread).
  count          Int     @default(1)

  readAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipient User @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  actor User? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([recipientId, createdAt])
  @@index([recipientId, readAt])
  @@index([actorId])
  @@index([recipientId, conversationId])
  @@map("notifications")
}

// MLS devices and key packages: an MLS member is a device, not a user.
model ChatDevice {
  /// Client-supplied id, embedded in the MLS credential of every key package; the server must use the same value.
  id                 String @id
  userId             String
  signaturePublicKey Bytes
  /// Pinned MLS ciphersuite name this device's key packages use.
  ciphersuite        String

  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  /// Set by explicit revocation, the 60-day dormancy sweep, or cap eviction; never by an ordinary logout.
  revokedAt  DateTime?

  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  keyPackages      MlsKeyPackage[]
  sentHandshakes   MlsHandshake[]
  receivedWelcomes MlsWelcome[]

  @@index([userId, revokedAt])
  @@map("chat_devices")
}

enum MlsKeyPackageKind {
  /// Claimed exactly once, never reusable.
  SINGLE_USE
  /// Never consumed by a claim; the fallback when no SINGLE_USE packages remain.
  LAST_RESORT
}

model MlsKeyPackage {
  id       String            @id @default(cuid())
  deviceId String
  kind     MlsKeyPackageKind @default(SINGLE_USE)

  /// The encoded MLS KeyPackage wire bytes, verified at upload time.
  payload Bytes

  createdAt       DateTime  @default(now())
  expiresAt       DateTime
  /// Only set for SINGLE_USE packages; LAST_RESORT is read without being claimed.
  claimedAt       DateTime?
  claimedByUserId String?

  device ChatDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, kind, claimedAt])
  /// Serves the hourly deleteExpiredKeyPackages filter on expiresAt alone.
  @@index([expiresAt])
  @@map("mls_key_packages")
}

// Handshake log: a Commit is the only thing that advances mlsEpoch, one per epoch. Never pruned, since members replay every Commit.
model MlsHandshake {
  id             String  @id @default(cuid())
  conversationId String
  /// The epoch this Commit was built FROM; applying it moves the group to epoch+1, and @@unique allows one Commit per epoch.
  epoch          Int
  /// Nullable, SetNull on delete: the Commit is shared group state members still need, so it must outlive the sender's device.
  senderDeviceId String?

  /// Opaque encoded MLS Commit bytes; the server only routes and orders them.
  payload       Bytes
  /// SHA-256 of payload, to recognise retried duplicate submissions.
  payloadSha256 String

  /// Declared and server-attested device changes: addedDevices = [{ deviceId, userId, signaturePublicKey (base64) }], removedDevices = [{ deviceId, userId }]; other members verify against them. False (arrays empty) for Commits accepted before tracking.
  membershipDeclared Boolean @default(false)
  addedDevices       Json    @default("[]")
  removedDevices     Json    @default("[]")

  createdAt DateTime @default(now())

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderDevice ChatDevice?      @relation(fields: [senderDeviceId], references: [id], onDelete: SetNull)

  @@unique([conversationId, epoch])
  @@map("mls_handshakes")
}

/// Per-recipient-device Welcome, delivered once then marked consumed.
model MlsWelcome {
  id                String @id @default(cuid())
  conversationId    String
  recipientDeviceId String

  payload Bytes

  createdAt  DateTime  @default(now())
  consumedAt DateTime?

  conversation    ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  recipientDevice ChatDevice       @relation(fields: [recipientDeviceId], references: [id], onDelete: Cascade)

  @@index([recipientDeviceId, consumedAt])
  /// Conversation deletes cascade here; without this each one scans the table.
  @@index([conversationId])
  @@map("mls_welcomes")
}

enum OutboxEventStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
}

model OutboxEvent {
  id String @id

  type        String
  version     Int
  aggregateId String

  payload Json

  occurredAt DateTime

  status OutboxEventStatus @default(PENDING)

  attemptCount Int       @default(0)
  availableAt  DateTime  @default(now())
  processingAt DateTime?
  publishedAt  DateTime?
  lastError    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, availableAt, createdAt])
  @@index([aggregateId, createdAt])
  @@map("outbox_events")
}

/// The server's record of which devices are leaves in a conversation's MLS ratchet tree. The tree
/// itself is opaque to the server; this is kept in sync with accepted Commits in the same
/// transaction (MlsHandshakesRepository.acceptHandshake) so the server always knows who still
/// holds group secrets.
///
/// deviceId and userId are deliberately plain strings, not relations: a leaf outlives its device
/// row (deleting an account cascades ChatDevice away, but the leaf keeps holding group secrets
/// until a Remove Commit lands), and the row must still say whose leaf it was to queue that removal.
///
/// A row is history once removedEpoch is set - a device removed and later re-added gets a new row.
/// Epochs are the group's epoch AFTER the Commit (the founder device joins at 0).
///
/// No @@unique here: at most one ACTIVE row (removedEpoch IS NULL) may exist per device, which
/// Prisma cannot express as a WHERE-scoped unique index, so the real constraint is a hand-written
/// partial unique index in migration 20260921100000_add_mls_group_membership
/// ("mls_group_members_active_device_key"), alongside a CHECK on the epochs
/// ("mls_group_members_epochs_check"). Keep both migration lines when regenerating.
model MlsGroupMember {
  id             String @id @default(cuid())
  conversationId String
  deviceId       String
  userId         String

  addedEpoch   Int
  removedEpoch Int?

  createdAt DateTime @default(now())

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, removedEpoch])
  @@index([conversationId, userId])
  /// The poll's "is this device in the group" probes filter on both columns.
  @@index([deviceId, removedEpoch])
  @@map("mls_group_members")
}

/// A member's client refused a Commit; recorded so an admin can see which sender and Commit froze the group. Device ids are plain strings so the record outlives the devices.
model MlsCommitFault {
  id               String  @id @default(cuid())
  conversationId   String
  /// The epoch the refused Commit was built from - identifies the handshake row.
  epoch            Int
  /// Who sent the refused Commit; null if that handshake row is gone.
  senderDeviceId   String?
  reporterDeviceId String
  reason           String

  createdAt DateTime @default(now())

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, epoch, reporterDeviceId])
  @@index([conversationId, epoch])
  @@map("mls_commit_faults")
}

/// Turns on encrypted history backup for a user. keyCheck is the client's encryption of a fixed string under the
/// backup key; the key itself never reaches the server.
model ChatBackupKey {
  userId              String    @id
  keyCheck            Bytes
  createdAt           DateTime  @default(now())
  /// Secret derived from the backup key by the client; verifies the proof that authorises replacing the key. Null on rows made before proofs existed.
  replaceSecret       Bytes?
  /// Single-use challenge for a key replacement; cleared when consumed.
  challengeNonce      Bytes?
  challengeExpiresAt  DateTime?
  /// When a proof-less delete request takes effect; the backup stays usable until then. Null when none is scheduled.
  deletionScheduledAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("chat_backup_keys")
}

/// One message's decrypted envelope, encrypted client-side under the backup key. conversationId and messageId are
/// plain strings, not relations, so a backup outlives a deleted message or conversation.
model ChatBackupBlob {
  id             String   @id @default(cuid())
  userId         String
  conversationId String
  messageId      String
  ciphertext     Bytes
  /// ciphertext length in bytes, kept so the quota is a cheap SUM.
  size           Int
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, messageId])
  /// Paging on restore walks a user's blobs in (createdAt, id) order.
  @@index([userId, createdAt, id])
  @@map("chat_backup_blobs")
}

model ProcessedEvent {
  eventId     String
  consumer    String
  processedAt DateTime @default(now())

  @@id([eventId, consumer])
  @@index([consumer, processedAt])
  @@map("processed_events")
}

// One row per (post/comment, mentioned user) once notified, so editing a mention out and back in never pings twice.
model Mention {
  entityType NotificationEntityType
  entityId   String
  userId     String
  createdAt  DateTime               @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([entityType, entityId, userId])
  @@index([userId])
  @@map("mentions")
}

model PostSave {
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([userId, postId])
  @@index([userId, createdAt, postId])
  @@index([postId])
  @@map("post_saves")
}
