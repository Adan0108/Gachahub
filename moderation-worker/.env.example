# Local loopback only. Production defaults require HTTPS and Kafka TLS.
WORKER_ENV=local
BACKEND_BASE_URL=http://localhost:3000
MODERATION_WORKER_TOKEN=replace-with-32-or-more-random-characters
KAFKA_BROKERS=localhost:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_MODERATION_REQUEST_TOPIC=gachahub.moderation.requests
KAFKA_MODERATION_RESULT_TOPIC=gachahub.moderation.results
KAFKA_MODERATION_QUARANTINE_TOPIC=gachahub.moderation.requests.quarantine
KAFKA_MODERATION_WORKER_GROUP_ID=gachahub-moderation-worker
HTTP_TIMEOUT_SECONDS=10
HTTP_ATTEMPTS=3
RETRY_BASE_SECONDS=0.5
DELIVERY_TIMEOUT_SECONDS=15
# For secured Kafka:
# KAFKA_SECURITY_PROTOCOL=SASL_SSL
# KAFKA_SASL_MECHANISM=SCRAM-SHA-512
# KAFKA_SASL_USERNAME=worker
# KAFKA_SASL_PASSWORD=replace-with-secret
# KAFKA_SSL_CA_LOCATION=C:/certs/ca.pem
# Optional mTLS: KAFKA_SSL_CERTIFICATE_LOCATION, KAFKA_SSL_KEY_LOCATION,
# KAFKA_SSL_KEY_PASSWORD
