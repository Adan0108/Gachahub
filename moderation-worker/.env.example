# Host-run defaults. Compose overrides backend/Kafka addresses and selects the real model.
# Copy to .env and replace the token with the same value configured in backend/.env.
# WORKER_ENV=local additionally allows HTTP to the exact host.docker.internal name.
# Production defaults still require HTTPS and Kafka TLS.
WORKER_ENV=local
BACKEND_BASE_URL=http://localhost:3000
MODERATION_WORKER_TOKEN=replace-with-32-or-more-random-characters
KAFKA_BROKERS=localhost:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_MODERATION_REQUEST_TOPIC=gachahub.moderation.requests
KAFKA_MODERATION_RESULT_TOPIC=gachahub.moderation.results
KAFKA_MODERATION_QUARANTINE_TOPIC=gachahub.moderation.requests.quarantine
KAFKA_MODERATION_WORKER_GROUP_ID=gachahub-moderation-worker
HTTP_TIMEOUT_SECONDS=10
HTTP_ATTEMPTS=3
RETRY_BASE_SECONDS=0.5
DELIVERY_TIMEOUT_SECONDS=15
# Fixture remains the default. For Stage 2E use huggingface and set the backend's
# MODERATION_CLASSIFIER_PROFILE=toxicity-mmbert-small-v1 before creating a report.
CLASSIFIER_BACKEND=fixture
# Real inference uses a reusable child process; timeout produces a failed generation, never stale findings.
CLASSIFIER_TIMEOUT_SECONDS=90
CLASSIFIER_STARTUP_TIMEOUT_SECONDS=120
CLASSIFIER_MODEL_NAME=Horizon-Labs/multilingual-toxicity-small
CLASSIFIER_MODEL_REVISION=01adcc628a33848569816d4851a38544c321b92c
CLASSIFIER_MAX_LENGTH=256
# For secured Kafka:
# KAFKA_SECURITY_PROTOCOL=SASL_SSL
# KAFKA_SASL_MECHANISM=SCRAM-SHA-512
# KAFKA_SASL_USERNAME=worker
# KAFKA_SASL_PASSWORD=replace-with-secret
# KAFKA_SSL_CA_LOCATION=C:/certs/ca.pem
# Optional mTLS: KAFKA_SSL_CERTIFICATE_LOCATION, KAFKA_SSL_KEY_LOCATION,
# KAFKA_SSL_KEY_PASSWORD
